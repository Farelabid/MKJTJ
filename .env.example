# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Server Configuration
PORT=5000
NODE_ENV=production

# IndoStreamServer Credentials (for backup streaming server)
# Basic Auth format: https://username:password@domain
# Leave empty if not using IndoStreamServer backup
INDOSTREAM_USERNAME=
INDOSTREAM_PASSWORD=

# Radio Streaming Configuration
# Icecast Primary Server
ICECAST_URL=https://stream-eu-nc.arenastreaming.com:5450/

# IndoStreamServer Backup (7.html format)
INDOSTREAM_URL=https://live1.indostreamserver.com:8012/7.html

# EMA Configuration (Optional - defaults in code)
# EMA_ALPHA=0.25
# DEVICE_TO_LISTENER_MULTIPLIER=11
# EMA_INTERVAL_SECONDS=30
# SNAPSHOT_INTERVAL_MINUTES=5

# Alert Configuration (Optional)
# ALERT_MIN_LISTENERS=10
# ALERT_MAX_LISTENERS=10000
